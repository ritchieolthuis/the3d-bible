# Default index file
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Fix broken double-nested links from AI hallucinations (301 permanent redirect)
  RewriteRule ^3dBijbel/(.*)$ /3dBijbel/$1 [R=301,L,NE]


  # Strip explicit index.html requests (301 permanent redirect)
  RewriteCond %{THE_REQUEST} \s/+(.+/)?index\.html[\s?] [NC]
  RewriteRule ^(.*)index\.html$ $1 [R=301,L,NE]

  # Fallback routing for SPAs & deep links
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . index.html [L]
</IfModule>

# MIME Types for WebGPU, 3D Assets, Draco & Media
<IfModule mod_mime.c>
  AddType application/wasm .wasm
  AddType model/gltf-binary .glb .model
  AddType application/octet-stream .bin
  AddType image/webp .webp
  AddType video/mp4 .mp4
  AddType application/manifest+json .webmanifest
</IfModule>

# Browser Caching & Performance for SEO Core Web Vitals
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType application/wasm "access plus 1 year"
  ExpiresByType model/gltf-binary "access plus 1 year"
</IfModule>

# Enable GZIP Compression for Fast Loading
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml application/wasm
</IfModule>
